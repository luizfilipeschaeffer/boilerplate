# Self-hosted — copie para .env neste diretório (não commitar .env)
# Desenvolvimento local: cp infra/self-hosted/.env.example infra/self-hosted/.env

DEPLOYMENT_MODE=self_hosted
AUTH_MODE=central

# Gerado automaticamente pelo install-vps.sh se ausente (openssl rand -base64 32)
AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32

# Chave de envelope para credenciais de integradores (44 chars base64)
INTEGRATOR_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# URL pública do ERP (wizard /setup e callbacks OAuth)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Plataforma central Boilerplate (licença, marketplace, SSO)
CENTRAL_API_URL=http://host.docker.internal:3002

# Token obtido no platform-admin após registrar a instalação (opcional no install)
# INSTALLATION_KEY=inst_xxxx
# INSTALLATION_ID=

# Assinatura offline de licença (dev; produção usa valor da plataforma)
LICENSE_SIGNING_KEY=dev-license-signing-key-change-me
LICENSE_OFFLINE_GRACE_HOURS=72

# Domínios permitidos (vírgula) — preenchido no wizard /setup
# ALLOWED_HOSTS=erp.cliente.com.br

# Imagens Docker (preenchido pelo install-vps.sh em produção)
# BOILERPLATE_IMAGE=minhaempresa
# BOILERPLATE_REGISTRY=minhaempresa
# BOILERPLATE_VERSION=latest

# Porta HTTP exposta (docker-compose.prod.yml)
# BOILERPLATE_HTTP_PORT=3000
