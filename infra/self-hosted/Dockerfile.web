# Self-hosted — apps/web (Next.js)
FROM oven/bun:1.3.14 AS base
WORKDIR /app

FROM base AS builder
COPY package.json bun.lock turbo.json ./
COPY apps/web ./apps/web
COPY packages ./packages
COPY modules ./modules
COPY community ./community

RUN bun install --frozen-lockfile

# Valores só para generate/build — runtime vem do compose/.env
ENV NODE_ENV=production
ENV DATABASE_URL=postgresql://build:build@localhost:5432/build
ENV AUTH_SECRET=docker-build-only-not-for-runtime
ENV NEXT_PUBLIC_APP_URL=http://localhost:3000
ENV INTEGRATOR_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

RUN bunx turbo run build --filter=@boilerplate/web

FROM base AS runner
ENV NODE_ENV=production
WORKDIR /app

COPY --from=builder /app/package.json /app/bun.lock /app/turbo.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/web ./apps/web
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/modules ./modules
COPY --from=builder /app/community ./community

WORKDIR /app/apps/web
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD bun -e "fetch('http://127.0.0.1:3000/api/setup/status').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["bunx", "next", "start", "-H", "0.0.0.0", "-p", "3000"]
