# Copiar para .env na raiz do monorepo (obrigatório para Prisma e apps):
#   copy .env.example .env
# Também aceito: .env.development (usado se .env não existir)
# Não commitar .env / .env.local
# Setup: bun install (na raiz) — ver README.md

# PostgreSQL — Docker (infra/docker, porta 5454)
DATABASE_URL=postgresql://boilerplate:boilerplate@localhost:5454/boilerplate

# Next.js 16.2.6 — gerar com: openssl rand -base64 32
AUTH_SECRET=
