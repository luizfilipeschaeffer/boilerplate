# Copiar para .env na raiz do monorepo (obrigatório para Prisma e apps):
#   copy .env.example .env
# Também aceito: .env.development (usado se .env não existir)
# Não commitar .env / .env.local
# Setup: bun install (na raiz) — ver README.md

# PostgreSQL — Docker (infra/docker, porta 5454)
DATABASE_URL=postgresql://boilerplate:boilerplate@localhost:5454/boilerplate

# Next.js 16.2.6 — gerar com: openssl rand -base64 32
AUTH_SECRET=

# URL pública do app web (links nos e-mails, ex. botão Copiar)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend — verificação de e-mail no cadastro (Aprendiz)
# https://resend.com/api-keys — em dev sem chave o código aparece no terminal
RESEND_API_KEY=
RESEND_FROM_EMAIL=Boilerplate <onboarding@resend.dev>

# platform-admin — apenas desenvolvimento local (bun run db:seed-platform-admin)
# Defina e-mail e senha só em .env.development (gitignored). Nunca commite senhas reais.
PLATFORM_ADMIN_SEED_EMAIL=
PLATFORM_ADMIN_SEED_PASSWORD=
PLATFORM_ADMIN_SEED_NAME=Super Admin
# Em production o seed é bloqueado; staging/CI só com secret + ALLOW_PLATFORM_ADMIN_SEED=true
# ALLOW_PLATFORM_ADMIN_SEED=
