# Copiar para .env na raiz do monorepo (obrigatório para Prisma e apps):
#   copy .env.example .env
# Também aceito: .env.development (usado se .env não existir)
# Não commitar .env / .env.local
# Setup: bun install (na raiz) — ver README.md

# PostgreSQL — Docker (infra/docker, porta 5454)
# Tabelas da plataforma (Prisma) ficam no schema PostgreSQL "boilerplate", não em "public"
DATABASE_URL=postgresql://boilerplate:boilerplate@localhost:5454/boilerplate

# Next.js 16.2.6 — gerar com: openssl rand -base64 32
# Preferir secrets separados por app (fallback legado: AUTH_SECRET)
AUTH_SECRET=
# AUTH_SECRET_WEB=
# AUTH_SECRET_PLATFORM_ADMIN=

# Rate limiting (Upstash Redis — opcional em dev)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Webhooks de pagamento — HMAC sha256 (obrigatório em production)
# PAYMENT_WEBHOOK_SECRET=

# platform-admin — restringir por IP (opcional)
# PLATFORM_ADMIN_ALLOWED_IPS=203.0.113.10,198.51.100.5

# Hosts confiáveis em production (Auth.js trustHost)
# AUTH_TRUSTED_HOSTS=app.example.com,admin.example.com

# Rede local — troque pelo IP da sua máquina (ipconfig / ifconfig)
# LAN_HOST=192.168.3.3
# NEXT_PUBLIC_APP_URL=http://192.168.3.3:3000
# DEV_ALLOWED_ORIGIN=http://192.168.3.3:3000,http://localhost:3000
# NEXT_PUBLIC_PLATFORM_ADMIN_URL=http://192.168.3.3:3002
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEV_ALLOWED_ORIGIN=http://localhost:3000

# AUTH_URL por app — definir na raiz (.env / .env.development), não em apps/*/
# AUTH_URL_WEB=http://localhost:3000
# AUTH_URL_ADMIN=http://localhost:3002
# DEV_ALLOWED_ORIGIN_WEB=http://localhost:3000
# DEV_ALLOWED_ORIGIN_ADMIN=http://localhost:3002

# Envelope encryption — credenciais de integradores (obrigatório em production/staging)
# Gerar com: openssl rand -base64 32
INTEGRATOR_ENCRYPTION_KEY=

# Resend — credenciais via integrador (db:seed-integrator-credentials + UI)
RESEND_FROM_EMAIL=Boilerplate <onboarding@resend.dev>

# platform-admin — apenas desenvolvimento local (bun run db:seed-platform-admin)
# Defina e-mail e senha só em .env.development (gitignored). Nunca commite senhas reais.
PLATFORM_ADMIN_SEED_EMAIL=
PLATFORM_ADMIN_SEED_PASSWORD=
PLATFORM_ADMIN_SEED_NAME=Super Admin
# Em production o seed é bloqueado; staging/CI só com secret + ALLOW_PLATFORM_ADMIN_SEED=true
# ALLOW_PLATFORM_ADMIN_SEED=

# Bootstrap Vercel (platform-admin) — ver doc/vercel/README.md
# RUN_VERCEL_DB_BOOTSTRAP=true
# ALLOW_INTEGRATOR_CREDENTIALS_SEED=true

# Fase 2 — Aprendiz com LLM (opcional; sem chave usa templates locais)
# APRENDIZ_LLM_ENABLED=true
# OPENAI_API_KEY=
# APRENDIZ_LLM_MODEL=gpt-4o-mini

# Fase 2 — Gateway Asaas (opcional; sem chave usa mock)
# ASAAS_API_KEY=
# ASAAS_API_URL=https://sandbox.asaas.com/api/v3
