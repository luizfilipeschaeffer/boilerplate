  @@schema("boilerplate")
  @@map("segment_sector_modules")
}

model SegmentVitalModule {
  id              String @id @default(uuid())
  segmentSlug     String @map("segment_slug")
  vitalModuleLabel String @map("vital_module_label")

  segment MarketSegment @relation(fields: [segmentSlug], references: [slug], onDelete: Cascade)

  @@unique([segmentSlug, vitalModuleLabel])
  @@schema("boilerplate")
  @@map("segment_vital_modules")
}

/// Histórico de evolução de profundidade D — PRD §5.0.1
model ModuleDepthChangelog {
  id            String   @id @default(uuid())
  moduleId      String   @map("module_id")
  title         String
  publicSummary String   @map("public_summary")
  depthFrom     Int      @map("depth_from")
  depthTo       Int      @map("depth_to")
  deliveryMarco String?  @map("delivery_marco")
  showToTenants Boolean  @default(true) @map("show_to_tenants")
  releasedAt    DateTime @default(now()) @map("released_at")

  module CoreModuleCatalog @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId, releasedAt])
  @@schema("boilerplate")
  @@map("module_depth_changelog")
}

model ModuloAtivo {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  moduloId       String   @map("modulo_id")
  ativadoEm      DateTime @default(now()) @map("ativado_em")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, moduloId])
  @@schema("boilerplate")
  @@map("modulos_ativos")
}

model ModuloDemanda {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  moduloId       String   @map("modulo_id")
  motivo         String?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@schema("boilerplate")
  @@map("modulo_demanda")
}

/// Preço mensal por módulo (add-on) — PRD §12.2
model ModuloPreco {
  moduleId              String   @id @map("module_id")
  precoMensalCentavos   Int      @map("preco_mensal_centavos")
  faseMinima            Int      @default(1) @map("fase_minima")
  cobrancaAvulsa        Boolean  @default(true) @map("cobranca_avulsa")
  ativo                 Boolean  @default(true)
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@schema("boilerplate")
  @@map("modulo_precos")
}

/// Plano base por faixa de fase — PRD §12.1
model PlanoBase {
  id                  String   @id
  nome                String
  precoMensalCentavos Int      @map("preco_mensal_centavos")
  faseMinima          Int      @map("fase_minima")
  faseMaxima          Int      @map("fase_maxima")
  modulosInclusos     Json     @default("[]") @map("modulos_inclusos")
  ativo               Boolean  @default(true)
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@schema("boilerplate")
  @@map("planos_base")
}

/// Bundle de módulos com preço único — PRD §12.2 / §9.3
model BundlePreco {
  id                  String   @id
  nome                String
  moduleIds           Json     @default("[]") @map("module_ids")
  precoMensalCentavos Int      @map("preco_mensal_centavos")
  ativo               Boolean  @default(true)
  updatedAt           DateTime @updatedAt @map("updated_at")

  segmentPhaseConfigs SegmentPhaseConfig[]

  @@schema("boilerplate")
  @@map("bundle_precos")
}

/// Rascunho do cadastro conversacional (reutilizado no onboarding sem repetir perguntas)
model SignupDraft {
  email     String   @id
  payload   Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@schema("boilerplate")
  @@map("signup_drafts")
}

/// Código de verificação de e-mail no cadastro (Aprendiz)
model SignupEmailVerification {
  id         String    @id @default(uuid())
  email      String
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  verifiedAt DateTime? @map("verified_at")
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@schema("boilerplate")
  @@map("signup_email_verifications")
}

/// Código de acesso ao painel sem senha (login por e-mail)
model LoginEmailVerification {
  id         String    @id @default(uuid())
  email      String
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  verifiedAt DateTime? @map("verified_at")
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@schema("boilerplate")
  @@map("login_email_verifications")
}

/// Código para recuperação de senha (login do tenant)
model PasswordResetVerification {
  id         String    @id @default(uuid())
  email      String
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  verifiedAt DateTime? @map("verified_at")
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@schema("boilerplate")
  @@map("password_reset_verifications")
}

/// Auditoria de eventos de domínio (PRD §8.9)
model DomainEvent {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  eventType      String   @map("event_type")
  payload        Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@schema("boilerplate")
  @@map("domain_events")
}

/// Conta de assinante na plataforma central (billing entity)
model PlatformCustomerAccount {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  organizationId String   @unique @map("organization_id")
  /// customer_owner | customer_billing | customer_technical
  role           String   @default("customer_owner")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@schema("boilerplate")
  @@map("platform_customer_accounts")
}

/// Assinatura central vinculada à org de billing
model PlatformSubscription {
  id             String    @id @default(uuid())
  organizationId String    @unique @map("organization_id")
  planId         String    @map("plan_id")
  /// active | past_due | expired | suspended | trial
  status         String    @default("trial")
  expiresAt      DateTime? @map("expires_at")
  paymentRef     String?   @map("payment_ref")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@schema("boilerplate")
  @@map("platform_subscriptions")
}

/// Entitlements explícitos (módulos, features, integradores)
model EntitlementGrant {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  installationId String?  @map("installation_id")
  entitlement    String
  grantedAt      DateTime @default(now()) @map("granted_at")
  expiresAt      DateTime? @map("expires_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, installationId, entitlement])
  @@index([organizationId])
  @@schema("boilerplate")
  @@map("entitlement_grants")
}

/// Instalação self-hosted registrada na plataforma central
model SelfHostedInstallation {
  id               String    @id @default(uuid())
  organizationId   String    @map("organization_id")
  name             String
  installationKeyHash String @map("installation_key_hash")
  publicUrl        String?   @map("public_url")
  /// pending | active | suspended | revoked
  status           String    @default("pending")
  version          String    @default("0.0.0")
  lastHeartbeatAt  DateTime? @map("last_heartbeat_at")
  healthStatus     String?   @map("health_status")
  lastMigrationStatus String? @map("last_migration_status")
  metadata         Json      @default("{}")
  /// Hosts/origins permitidos para acessar esta instalação (ex.: erp.cliente.com.br)
  allowedOrigins   Json      @default("[]") @map("allowed_origins")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tokens       InstallationToken[]
  credentials  InstallationCredential[]
  events       InstallationEvent[]
  supportTickets SupportTicket[]

  @@index([organizationId])
  @@index([status])
  @@schema("boilerplate")
  @@map("self_hosted_installations")
}

/// Token one-time para bootstrap da VPS
model InstallationToken {
  id             String    @id @default(uuid())
  installationId String?   @map("installation_id")
  organizationId String    @map("organization_id")
  tokenHash      String    @map("token_hash")
  expiresAt      DateTime  @map("expires_at")
  usedAt         DateTime? @map("used_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  installation SelfHostedInstallation? @relation(fields: [installationId], references: [id], onDelete: SetNull)

  @@index([tokenHash])
  @@index([organizationId])
  @@schema("boilerplate")
  @@map("installation_tokens")
}

/// Credenciais OAuth da instalação (criptografadas)
model InstallationCredential {
  id             String   @id @default(uuid())
  installationId String   @unique @map("installation_id")
  oauthClientId  String   @map("oauth_client_id")
  secretsEncrypted String @map("secrets_encrypted") @db.Text
  rotatedAt      DateTime? @map("rotated_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  installation SelfHostedInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)

  @@schema("boilerplate")
  @@map("installation_credentials")
}

model InstallationEvent {
  id             String   @id @default(uuid())
  installationId String   @map("installation_id")
  eventType      String   @map("event_type")
  payload        Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")

  installation SelfHostedInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)

  @@index([installationId, createdAt])
  @@schema("boilerplate")
  @@map("installation_events")
}

/// Catálogo marketplace central
model MarketplaceListing {
  id                     String   @id @default(uuid())
  externalId             String   @unique @map("external_id")
  /// module | submodule | integrator
  kind                   String
  name                   String
  description            String?  @db.Text
  ownerDeveloperId       String?  @map("owner_developer_id")
  /// experimental | approved | recommended | official | enterprise
  listingStatus          String   @default("approved") @map("listing_status")
  pricingModel           String   @default("free") @map("pricing_model")
  priceMonthlyCents      Int?     @map("price_monthly_cents")
  currentVersion         String   @map("current_version")
  minimumPlatformVersion String   @map("minimum_platform_version")
  entitlementsRequired   Json     @default("[]") @map("entitlements_required")
  migrationManifest      Json     @default("{}") @map("migration_manifest")
  changelog              Json     @default("[]")
  packageChecksum        String?  @map("package_checksum")
  active                 Boolean  @default(true)
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@index([kind, listingStatus])
  @@schema("boilerplate")
  @@map("marketplace_listings")
}

model ReleaseCatalog {
