generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  // Vercel (Linux): rhel-openssl-3.0.x — local dev: native (Windows/macOS)
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["boilerplate"]
}

model Organization {
  id                String   @id @default(uuid())
  name              String
  slug              String   @unique
  /// tenant | franchisor | subsidiary
  orgType           String   @default("tenant") @map("org_type")
  parentOrganizationId String? @map("parent_organization_id")
  schemaName        String   @unique @map("schema_name")
  phase             Int      @default(1)
  /// lead | trial | active | expansion | churn_risk
  crmStage          String   @default("trial") @map("crm_stage")
  tipoNegocio       String   @map("tipo_negocio")
  segmentoAtuacao   String?  @map("segmento_atuacao")
  marketSegmentSlug String?  @map("market_segment_slug")
  diagnosedPhase    Int?     @map("diagnosed_phase")
  declaredPhase     Int?     @map("declared_phase")
  /// Fase P aguardando confirmação do dono no wizard de expansão
  pendingExpansionPhase Int? @map("pending_expansion_phase")
  /// pending_payment | pre_active | trial | active | blocked
  provisioningStatus String  @default("trial") @map("provisioning_status")
  paymentIntegratorId String? @map("payment_integrator_id")
  paymentCustomerRef  String? @map("payment_customer_ref")
  paymentMethodVerifiedAt DateTime? @map("payment_method_verified_at")
  trialEndsAt       DateTime? @map("trial_ends_at")
  hasCnpj           Boolean  @default(false) @map("has_cnpj")
  cnpj              String?
  fiscalReady       Boolean  @default(false) @map("fiscal_ready")
  tipoNegocioInteresse String? @map("tipo_negocio_interesse")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  marketSegment     MarketSegment? @relation(fields: [marketSegmentSlug], references: [slug], onDelete: SetNull)
  parentOrganization Organization? @relation("OrgHierarchy", fields: [parentOrganizationId], references: [id], onDelete: SetNull)
  childOrganizations Organization[] @relation("OrgHierarchy")
  modulosAtivos  ModuloAtivo[]
  moduloDemanda  ModuloDemanda[]
  memberships    Membership[]
  branches       Branch[]
  departments    Department[]
  roleGrants     MembershipRoleGrant[]
  sellerInvites  SellerInvite[]
  crmDeals            CrmDeal[]
  crmNotes            PlatformCrmNote[]
  platformAccount     PlatformAccount?
  platformCommsThreads PlatformCommsThread[]
  platformActivities  PlatformActivity[]
  platformCommsConsents PlatformCommsConsent[]
  tenantIntegrators   TenantIntegrator[]
  customerAccount     PlatformCustomerAccount?
  selfHostedInstallations SelfHostedInstallation[]
  platformSubscription PlatformSubscription?
  entitlementGrants   EntitlementGrant[]
  supportTickets      SupportTicket[]

  @@index([marketSegmentSlug])
  @@index([provisioningStatus])
  @@schema("boilerplate")
  @@map("organizations")
}

/// Lead comercial antes de virar tenant (PRD §17.3)
model PlatformLead {
  id              String   @id @default(uuid())
  name            String
  email           String?
  tipoNegocio     String?  @map("tipo_negocio")
  estimatedPhase  Int?     @map("estimated_phase")
  crmStage        String   @default("lead") @map("crm_stage")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  crmDeals              CrmDeal[]
  crmNotes              PlatformCrmNote[]
  platformAccount       PlatformAccount?
  platformCommsThreads  PlatformCommsThread[]
  platformActivities    PlatformActivity[]
  platformCommsConsents PlatformCommsConsent[]
  platformContacts      PlatformContact[]

  @@schema("boilerplate")
  @@map("platform_leads")
}

/// Oportunidade / vínculo pipeline (organização ou lead)
model CrmDeal {
  id                  String   @id @default(uuid())
  organizationId      String?  @map("organization_id")
  platformLeadId      String?  @map("platform_lead_id")
  platformAccountId   String?  @map("platform_account_id")
  phase               Int      @default(1)
  pipelineStage       String   @map("pipeline_stage")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  organization    Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  platformLead    PlatformLead?   @relation(fields: [platformLeadId], references: [id], onDelete: Cascade)
  platformAccount PlatformAccount? @relation(fields: [platformAccountId], references: [id], onDelete: SetNull)
  notes           PlatformCrmNote[]

  @@schema("boilerplate")
  @@map("crm_deals")
}

model PlatformCrmNote {
  id                    String   @id @default(uuid())
  body                  String
  organizationId        String?  @map("organization_id")
  platformLeadId        String?  @map("platform_lead_id")
  crmDealId             String?  @map("crm_deal_id")
  platformUserId        String?  @map("platform_user_id")
  createdAt             DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  platformLead PlatformLead? @relation(fields: [platformLeadId], references: [id], onDelete: Cascade)
  crmDeal      CrmDeal?      @relation(fields: [crmDealId], references: [id], onDelete: Cascade)

  @@schema("boilerplate")
  @@map("platform_crm_notes")
}

/// Conta comercial da plataforma (lead ou organização) — PRD §17.3
model PlatformAccount {
  id               String   @id @default(uuid())
  name             String
  organizationId   String?  @unique @map("organization_id")
  platformLeadId   String?  @unique @map("platform_lead_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  platformLead   PlatformLead? @relation(fields: [platformLeadId], references: [id], onDelete: Cascade)
  contacts       PlatformContact[]
  crmDeals       CrmDeal[]

  @@schema("boilerplate")
  @@map("platform_accounts")
}

/// Contato (decisor / usuário futuro) — PRD §17.3
model PlatformContact {
  id                String   @id @default(uuid())
  name              String
  email             String?
  phone             String?
  role              String?
  platformAccountId String?  @map("platform_account_id")
  platformLeadId    String?  @map("platform_lead_id")
  createdAt         DateTime @default(now()) @map("created_at")

  platformAccount PlatformAccount? @relation(fields: [platformAccountId], references: [id], onDelete: Cascade)
  platformLead    PlatformLead?    @relation(fields: [platformLeadId], references: [id], onDelete: Cascade)
  consents        PlatformCommsConsent[]

  @@schema("boilerplate")
  @@map("platform_contacts")
}

/// Thread omnichannel (inbox) — PRD §17.4
model PlatformCommsThread {
  id                     String    @id @default(uuid())
  subject                String
  channel                String
  /// client | internal — cliente/lead/org vs membro da equipe plataforma
  participantKind        String    @default("client") @map("participant_kind")
  status                 String    @default("open")
  lastMessageAt          DateTime? @map("last_message_at")
  organizationId         String?   @map("organization_id")
  platformLeadId         String?   @map("platform_lead_id")
  assignedPlatformUserId String?   @map("assigned_platform_user_id")
  peerPlatformUserId     String?   @map("peer_platform_user_id")
  helpdeskTicketId       String?   @map("helpdesk_ticket_id")
  helpdeskTicketOrgId    String?   @map("helpdesk_ticket_org_id")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  messages         PlatformCommsMessage[]
  organization     Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  platformLead     PlatformLead?  @relation(fields: [platformLeadId], references: [id], onDelete: Cascade)
  peerPlatformUser PlatformUser?  @relation("CommsPeer", fields: [peerPlatformUserId], references: [id], onDelete: SetNull)
  activities       PlatformActivity[]

  @@index([organizationId])
  @@index([platformLeadId])
  @@index([peerPlatformUserId])
  @@index([participantKind])
  @@schema("boilerplate")
  @@map("platform_comms_threads")
}

model PlatformCommsMessage {
  id        String   @id @default(uuid())
  threadId  String   @map("thread_id")
  direction String
  body      String
  fromLabel String?  @map("from_label")
  toLabel   String?  @map("to_label")
  createdAt DateTime @default(now()) @map("created_at")

  thread PlatformCommsThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@schema("boilerplate")
  @@map("platform_comms_messages")
}

/// Opt-in LGPD por canal — PRD §17.4
model PlatformCommsConsent {
  id                String    @id @default(uuid())
  channel           String
  organizationId    String?   @map("organization_id")
  platformLeadId    String?   @map("platform_lead_id")
  platformContactId String?   @map("platform_contact_id")
  consentedAt       DateTime  @default(now()) @map("consented_at")
  revokedAt         DateTime? @map("revoked_at")

  organization    Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  platformLead    PlatformLead?   @relation(fields: [platformLeadId], references: [id], onDelete: Cascade)
  platformContact PlatformContact? @relation(fields: [platformContactId], references: [id], onDelete: Cascade)

  @@schema("boilerplate")
  @@map("platform_comms_consents")
}

/// Atividade comercial (nota, ligação, mensagem) — PRD §17.3
model PlatformActivity {
  id               String   @id @default(uuid())
  activityType     String   @map("activity_type")
  body             String
  organizationId   String?  @map("organization_id")
  platformLeadId   String?  @map("platform_lead_id")
  platformUserId   String?  @map("platform_user_id")
  commsThreadId    String?  @map("comms_thread_id")
  createdAt        DateTime @default(now()) @map("created_at")

  organization   Organization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  platformLead   PlatformLead?      @relation(fields: [platformLeadId], references: [id], onDelete: Cascade)
  commsThread    PlatformCommsThread? @relation(fields: [commsThreadId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([platformLeadId])
  @@schema("boilerplate")
  @@map("platform_activities")
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  name           String?
  passwordHash   String?  @map("password_hash")
  sessionVersion Int      @default(0) @map("session_version")
  createdAt      DateTime @default(now()) @map("created_at")

  memberships Membership[]
  customerAccount PlatformCustomerAccount?
  developerAccount DeveloperAccount?

  @@schema("boilerplate")
  @@map("users")
}

/// Operadores internos do painel platform-admin (PRD §17.6)
model PlatformUser {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  passwordHash String?  @map("password_hash")
  /// platform_admin | platform_comercial | platform_suporte | platform_produto | platform_engenharia
  role         String   @default("platform_admin")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  commsPeerThreads PlatformCommsThread[] @relation("CommsPeer")

  @@schema("boilerplate")
  @@map("platform_users")
}

model Membership {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  organizationId  String   @map("organization_id")
  role            String   @default("dono")
  active          Boolean  @default(true)
  defaultBranchId String?  @map("default_branch_id")
  /// Atalhos pessoais da paleta (Alt+P); null = herda o padrão do setor
  commandPaletteShortcuts Json? @map("command_palette_shortcuts")
  createdAt       DateTime @default(now()) @map("created_at")

  user              User               @relation(fields: [userId], references: [id])
  organization      Organization       @relation(fields: [organizationId], references: [id])
  defaultBranch     Branch?            @relation(fields: [defaultBranchId], references: [id], onDelete: SetNull)
  membershipSectors       MembershipSector[]
  membershipSectorModules MembershipSectorModule[]
  roleGrants              MembershipRoleGrant[]
  teamMemberships         MembershipTeam[]

  @@unique([userId, organizationId])
  @@schema("boilerplate")
  @@map("memberships")
}

model Branch {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  slug           String
  active         Boolean  @default(true)
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  Membership[]
  departments  Department[]
  sectors      Sector[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@schema("boilerplate")
  @@map("branches")
}

/// Setor/departamento — alias conceitual de Department (Sector mantido por compatibilidade)
model Sector {
  id              String  @id @default(uuid())
  organizationId  String  @map("organization_id")
  branchId        String? @map("branch_id")
  name            String
  slug            String  @default("geral")
  coreSectorSlug  String? @map("core_sector_slug")
  /// hidden | em_breve | active — expansão por fase de produto
  visibilityStatus String @default("active") @map("visibility_status")
  /// Dashboard agregador cross-setor (ex.: Geral)
  isAggregator     Boolean @default(false) @map("is_aggregator")
  /// Atalhos de módulo: [{ "moduleId": "...", "primarySectorSlug": "..." }]
  moduleShortcuts  Json    @default("[]") @map("module_shortcuts")
  /// IDs dos cards do painel inicial por setor (ex.: cash_flow, clients, stock_alerts)
  dashboardCards  Json    @default("[\"cash_flow\",\"clients\",\"stock_alerts\"]") @map("dashboard_cards")
  /// IDs dos atalhos da paleta de comandos (Alt+P) por setor
  commandPaletteShortcuts Json @default("[\"action:catalogo-novo\",\"action:cliente-novo\",\"action:venda-nova\"]") @map("command_palette_shortcuts")

  branch                  Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  sectorModules           SectorModule[]
  membershipSectors       MembershipSector[]
  membershipSectorModules MembershipSectorModule[]
  teams                   Team[]
  department              Department?

  @@unique([organizationId, slug])
  @@index([branchId])
  @@schema("boilerplate")
  @@map("sectors")
}

/// Department — espelho de Sector para contratos enterprise (1:1 via sectorId)
model Department {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  branchId       String? @map("branch_id")
  sectorId       String  @unique @map("sector_id")
  name           String
  slug           String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  sector       Sector       @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  teams        Team[]

  @@unique([organizationId, slug])
  @@index([branchId])
  @@schema("boilerplate")
  @@map("departments")
}

model Team {
  id           String @id @default(uuid())
  departmentId String @map("department_id")
  sectorId     String @map("sector_id")
  name         String
  slug         String
  active       Boolean @default(true)

  department      Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  sector          Sector           @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  teamMemberships MembershipTeam[]

  @@unique([departmentId, slug])
  @@index([sectorId])
  @@schema("boilerplate")
  @@map("teams")
}

model MembershipTeam {
  membershipId String @map("membership_id")
  teamId       String @map("team_id")

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  team       Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([membershipId, teamId])
  @@schema("boilerplate")
  @@map("membership_teams")
}

/// RBAC contextual multinível (org → filial → departamento → equipe)
model MembershipRoleGrant {
  id             String  @id @default(uuid())
  membershipId   String  @map("membership_id")
  organizationId String  @map("organization_id")
  role           String
  branchId       String? @map("branch_id")
  departmentId   String? @map("department_id")
  teamId         String? @map("team_id")
  permissions    Json    @default("[]")
  createdAt      DateTime @default(now()) @map("created_at")

  membership   Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([membershipId, organizationId, branchId, departmentId, teamId])
  @@index([membershipId])
  @@index([organizationId])
  @@schema("boilerplate")
  @@map("membership_role_grants")
}

model SectorModule {
  id       String @id @default(uuid())
  sectorId String @map("sector_id")
  moduleId String @map("module_id")

  sector Sector @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@unique([sectorId, moduleId])
  @@index([sectorId])
  @@schema("boilerplate")
  @@map("sector_modules")
}

model MembershipSector {
  membershipId String @map("membership_id")
  sectorId     String @map("sector_id")

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  sector     Sector     @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@id([membershipId, sectorId])
  @@schema("boilerplate")
  @@map("membership_sectors")
}

/// Módulos e permissões explícitas do membro em um setor (vazio = herda setor + papel).
model MembershipSectorModule {
  membershipId String @map("membership_id")
  sectorId     String @map("sector_id")
  moduleId     String @map("module_id")
  permissions  Json?  @map("permissions")

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  sector     Sector     @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@id([membershipId, sectorId, moduleId])
  @@index([membershipId, sectorId])
  @@schema("boilerplate")
  @@map("membership_sector_modules")
}

model SellerInvite {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  tenantSellerId String    @map("tenant_seller_id")
  email          String
  token          String    @unique
  expiresAt      DateTime  @map("expires_at")
  acceptedAt     DateTime? @map("accepted_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([token])
  @@schema("boilerplate")
  @@map("seller_invites")
}

/// Setores universais do produto — PRD §5.0 / §8.12
model CoreSector {
  slug     String @id
  name     String
  camada   String
  presenca String
  ordem    Int    @default(0)

  modules CoreModuleCatalog[]

  @@schema("boilerplate")
  @@map("core_sectors")
}

/// Catálogo global de módulos de produto — PRD §8.12
model CoreModuleCatalog {
  id                   String  @id
  name                 String
  sectorSlug           String  @map("sector_slug")
  faseMinima           Int     @default(1) @map("fase_minima")
  implementationStatus String  @default("scaffold") @map("implementation_status")
  depthCurrent         Int     @default(0) @map("depth_current")
  depthTarget          Int     @default(3) @map("depth_target")
  depthTargetMarco     String? @map("depth_target_marco")
  deliveryMarco        String? @map("delivery_marco")
  registrySync         Boolean @default(true) @map("registry_sync")
  depthRubric          Json?   @map("depth_rubric")
  depthNotes           String? @map("depth_notes")
  updatedAt            DateTime @updatedAt @map("updated_at")

  sector    CoreSector             @relation(fields: [sectorSlug], references: [slug])
  changelog ModuleDepthChangelog[]

  @@index([sectorSlug])
  @@schema("boilerplate")
  @@map("core_modules_catalog")
}

/// Segmentos de mercado (estudo) — PRD §5.0.2
model MarketSegment {
  slug                 String  @id
  name                 String
  ordem                Int     @default(0)
  ativo                Boolean @default(true)
  icone                String?
  tipoNegocioSugeridos Json     @default("[]") @map("tipo_negocio_sugeridos")
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at")

  sectorModules        SegmentSectorModule[]
  vitalModules         SegmentVitalModule[]
  phaseConfigs         SegmentPhaseConfig[]
  sectorTemplates      SegmentSectorTemplate[]
  sectorModuleTemplates SegmentSectorModuleTemplate[]
  organizations        Organization[]

  @@schema("boilerplate")
  @@map("market_segments")
}

/// Template de setor tenant por segmento × fase mínima — PRD expansão por P
model SegmentSectorTemplate {
  id                String @id @default(uuid())
  segmentSlug       String @map("segment_slug")
  phaseMin          Int    @map("phase_min")
  coreSectorSlug    String @map("core_sector_slug")
  displayName       String @map("display_name")
  sectorSlug        String @map("sector_slug")
  /// hidden | em_breve | active na fase phaseMin
  visibilityDefault String @default("active") @map("visibility_default")
  isAggregator      Boolean @default(false) @map("is_aggregator")
  ordem             Int    @default(0)

  segment MarketSegment @relation(fields: [segmentSlug], references: [slug], onDelete: Cascade)

  @@unique([segmentSlug, sectorSlug])
  @@index([segmentSlug, phaseMin])
  @@schema("boilerplate")
  @@map("segment_sector_templates")
}

/// Matriz segmento × setor core × módulo de produto (pai/filho explícitos)
model SegmentSectorModuleTemplate {
  id                      String @id @default(uuid())
  segmentSlug             String @map("segment_slug")
  coreSectorSlug          String @map("core_sector_slug")
  moduleId                String @map("module_id")
  phaseMin                Int    @default(1) @map("phase_min")
  shortcutCoreSectorSlugs Json   @default("[]") @map("shortcut_core_sector_slugs")

  segment MarketSegment @relation(fields: [segmentSlug], references: [slug], onDelete: Cascade)

  @@unique([segmentSlug, moduleId, coreSectorSlug])
  @@index([segmentSlug])
  @@schema("boilerplate")
  @@map("segment_sector_module_templates")
}

/// Matriz segmento × fase P → bundle/módulos e política de trial/pagamento
model SegmentPhaseConfig {
  id                        String   @id @default(uuid())
  segmentSlug               String   @map("segment_slug")
  phase                     Int
  bundlePrecoId             String?  @map("bundle_preco_id")
  moduleIds                 Json     @default("[]") @map("module_ids")
  requiresPaymentValidation Boolean  @default(false) @map("requires_payment_validation")
  trialDays                 Int      @default(14) @map("trial_days")
  preActivateModules        Boolean  @default(true) @map("pre_activate_modules")
  ativo                     Boolean  @default(true)
  updatedAt                 DateTime @updatedAt @map("updated_at")

  segment     MarketSegment @relation(fields: [segmentSlug], references: [slug], onDelete: Cascade)
  bundlePreco BundlePreco?  @relation(fields: [bundlePrecoId], references: [id], onDelete: SetNull)

  @@unique([segmentSlug, phase])
  @@index([segmentSlug])
  @@schema("boilerplate")
  @@map("segment_phase_configs")
}

/// Catálogo de integradores (implementados e planejados) — seed via platform-catalog.json
model PlatformIntegratorCatalog {
  id                   String   @id
  label                String
  tipo                 String
  provider             String?
  description          String?
  /// implemented | scaffold | planned
  implementationStatus String   @default("planned") @map("implementation_status")
  modulosSuportados    Json     @default("[]") @map("modulos_suportados")
  packagePath          String?  @map("package_path")
  deliveryMarco        String?  @map("delivery_marco")
  ordem                Int      @default(0)
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@index([tipo])
  @@index([implementationStatus])
  @@schema("boilerplate")
  @@map("platform_integrator_catalog")
}

/// Gateways de pagamento habilitados na plataforma
model PlatformPaymentGateway {
  integratorId String   @id @map("integrator_id")
  label        String
  isDefault    Boolean  @default(false) @map("is_default")
  configSchema Json     @default("{}") @map("config_schema")
  ativo        Boolean  @default(true)
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@schema("boilerplate")
  @@map("platform_payment_gateways")
}

/// Credenciais default da plataforma por integrador (envelope encryption)
model PlatformIntegratorCredential {
  integratorId               String    @id @map("integrator_id")
  configPublic               Json      @default("{}") @map("config_public")
  credentialsEncrypted       String?   @map("credentials_encrypted") @db.Text
  configuredAt               DateTime? @map("configured_at")
  configuredByPlatformUserId String?   @map("configured_by_platform_user_id")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  @@schema("boilerplate")
  @@map("platform_integrator_credentials")
}

/// Integrador escolhido pelo tenant (pagamento) + override BYOK de credenciais
model TenantIntegrator {
  id                   String   @id @default(uuid())
  organizationId       String   @map("organization_id")
  integratorId         String   @map("integrator_id")
  config               Json     @default("{}")
  configPublic         Json     @default("{}") @map("config_public")
  credentialsEncrypted String?  @map("credentials_encrypted") @db.Text
  ativo                Boolean  @default(true)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, integratorId])
  @@index([organizationId])
  @@schema("boilerplate")
  @@map("tenant_integrators")
}

/// Auditoria de alterações em segmentos, fases, bundles e gateways
model PlatformConfigAuditLog {
  id                   String   @id @default(uuid())
  entityType           String   @map("entity_type")
  entityId             String   @map("entity_id")
  action               String
  actorPlatformUserId  String?  @map("actor_platform_user_id")
  diff                 Json     @default("{}")
  createdAt            DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([createdAt])
  @@schema("boilerplate")
  @@map("platform_config_audit_logs")
}

/// Publicações da comunidade (módulos e integradores) — moderação antes de uso pelos tenants
model EcosystemPublication {
  id                         String   @id @default(uuid())
  /// module | integrator
  kind                       String
  externalId                 String   @map("external_id")
  name                       String
  description                String?
  publisherName              String?  @map("publisher_name")
  publisherEmail             String?  @map("publisher_email")
  packageName                String?  @map("package_name")
  packagePath                String?  @map("package_path")
  /// payment, messaging, fiscal, etc. (integradores)
  category                   String?
  manifest                   Json     @default("{}")
  /// pending_review | approved | changes_requested | rejected
  moderationStatus           String   @default("pending_review") @map("moderation_status")
  reviewNotes                String?  @map("review_notes") @db.Text
  /// community | verified — verified após aprovação
  trustLevel                 String   @default("community") @map("trust_level")
  availableToTenants         Boolean  @default(false) @map("available_to_tenants")
  reviewedAt                 DateTime? @map("reviewed_at")
  reviewedByPlatformUserId   String?  @map("reviewed_by_platform_user_id")
  submittedAt                DateTime @default(now()) @map("submitted_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  @@unique([kind, externalId])
  @@index([moderationStatus])
  @@index([kind])
  @@schema("boilerplate")
  @@map("ecosystem_publications")
}

model SegmentSectorModule {
