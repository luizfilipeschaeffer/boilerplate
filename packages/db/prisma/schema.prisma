  targetType           String   @map("target_type")
  targetId             String   @map("target_id")
  version              String
  compatibility        Json     @default("{}")
  changelog            String   @db.Text
  migrationIds         Json     @default("[]") @map("migration_ids")
  artifactChecksum     String?  @map("artifact_checksum")
  publishedBy          String   @map("published_by")
  publishedAt          DateTime @default(now()) @map("published_at")

  @@unique([targetType, targetId, version])
  @@schema("boilerplate")
  @@map("release_catalog")
}

model DeveloperAccount {
  id               String    @id @default(uuid())
  userId           String    @unique @map("user_id")
  displayName      String    @map("display_name")
  githubUsername   String?   @map("github_username")
  publicProfileSlug String?  @map("public_profile_slug")
  termsAcceptedAt  DateTime  @map("terms_accepted_at")
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user  User @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles DeveloperRole[]

  @@schema("boilerplate")
  @@map("developer_accounts")
}

model DeveloperRole {
  id          String @id @default(uuid())
  developerId String @map("developer_id")
  moduleId    String @map("module_id")
  /// owner | maintainer | contributor | support
  role        String

  developer DeveloperAccount @relation(fields: [developerId], references: [id], onDelete: Cascade)

  @@unique([developerId, moduleId, role])
  @@schema("boilerplate")
  @@map("developer_roles")
}

model SupportTicket {
  id               String   @id @default(uuid())
  organizationId   String   @map("organization_id")
  installationId   String   @map("installation_id")
  createdByUserId  String?  @map("created_by_user_id")
  moduleId         String?  @map("module_id")
  integratorId     String?  @map("integrator_id")
  type             String
  status           String   @default("open")
  priority         String   @default("medium")
  subject          String
  sanitizedContext Json     @default("{}") @map("sanitized_context")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  installation SelfHostedInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  messages     SupportTicketMessage[]

  @@index([installationId, status])
  @@index([moduleId])
  @@schema("boilerplate")
  @@map("support_tickets")
}

model SupportTicketMessage {
  id         String   @id @default(uuid())
  ticketId   String   @map("ticket_id")
  authorType String   @map("author_type")
  authorId   String?  @map("author_id")
  body       String   @db.Text
  sanitized  Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@schema("boilerplate")
  @@map("support_ticket_messages")
}

model CustomerFeedback {
  id               String   @id @default(uuid())
  organizationId   String   @map("organization_id")
  installationId   String   @map("installation_id")
  moduleId         String?  @map("module_id")
  summary          String
  sanitizedDetails Json     @default("{}") @map("sanitized_details")
  /// pending | triaged | approved | rejected | published_github
  status           String   @default("pending")
  triageNotes      String?  @map("triage_notes") @db.Text
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  githubIssue GithubIssueLink?

  @@index([status])
  @@schema("boilerplate")
  @@map("customer_feedback")
}

model GithubIssueLink {
  id               String   @id @default(uuid())
  feedbackId       String   @unique @map("feedback_id")
  githubIssueNumber Int     @map("github_issue_number")
  githubRepo       String   @map("github_repo")
  labels           Json     @default("[]")
  moduleId         String?  @map("module_id")
  bountyAvailable  Boolean  @default(false) @map("bounty_available")
  status           String   @default("triagem")
  createdAt        DateTime @default(now()) @map("created_at")

  feedback CustomerFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@schema("boilerplate")
  @@map("github_issue_links")
}
