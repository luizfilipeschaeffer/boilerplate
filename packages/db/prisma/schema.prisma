generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["boilerplate"]
}

model Organization {
  id                String   @id @default(uuid())
  name              String
  slug              String   @unique
  schemaName        String   @unique @map("schema_name")
  phase             Int      @default(1)
  /// lead | trial | active | expansion | churn_risk
  crmStage          String   @default("trial") @map("crm_stage")
  tipoNegocio       String   @map("tipo_negocio")
  segmentoAtuacao   String?  @map("segmento_atuacao")
  hasCnpj           Boolean  @default(false) @map("has_cnpj")
  cnpj              String?
  fiscalReady       Boolean  @default(false) @map("fiscal_ready")
  tipoNegocioInteresse String? @map("tipo_negocio_interesse")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  modulosAtivos  ModuloAtivo[]
  moduloDemanda  ModuloDemanda[]
  memberships    Membership[]
  crmDeals            CrmDeal[]
  crmNotes            PlatformCrmNote[]
  platformAccount     PlatformAccount?
  platformCommsThreads PlatformCommsThread[]
  platformActivities  PlatformActivity[]
  platformCommsConsents PlatformCommsConsent[]

  @@schema("boilerplate")
  @@map("organizations")
}

/// Lead comercial antes de virar tenant (PRD §17.3)
model PlatformLead {
  id              String   @id @default(uuid())
  name            String
  email           String?
  tipoNegocio     String?  @map("tipo_negocio")
  estimatedPhase  Int?     @map("estimated_phase")
  crmStage        String   @default("lead") @map("crm_stage")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  crmDeals              CrmDeal[]
  crmNotes              PlatformCrmNote[]
  platformAccount       PlatformAccount?
  platformCommsThreads  PlatformCommsThread[]
  platformActivities    PlatformActivity[]
  platformCommsConsents PlatformCommsConsent[]
  platformContacts      PlatformContact[]

  @@schema("boilerplate")
  @@map("platform_leads")
}

/// Oportunidade / vínculo pipeline (organização ou lead)
model CrmDeal {
  id                  String   @id @default(uuid())
  organizationId      String?  @map("organization_id")
  platformLeadId      String?  @map("platform_lead_id")
  platformAccountId   String?  @map("platform_account_id")
  phase               Int      @default(1)
  pipelineStage       String   @map("pipeline_stage")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  organization    Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  platformLead    PlatformLead?   @relation(fields: [platformLeadId], references: [id], onDelete: Cascade)
  platformAccount PlatformAccount? @relation(fields: [platformAccountId], references: [id], onDelete: SetNull)
  notes           PlatformCrmNote[]

  @@schema("boilerplate")
  @@map("crm_deals")
}

model PlatformCrmNote {
  id                    String   @id @default(uuid())
  body                  String
  organizationId        String?  @map("organization_id")
  platformLeadId        String?  @map("platform_lead_id")
  crmDealId             String?  @map("crm_deal_id")
  platformUserId        String?  @map("platform_user_id")
  createdAt             DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  platformLead PlatformLead? @relation(fields: [platformLeadId], references: [id], onDelete: Cascade)
  crmDeal      CrmDeal?      @relation(fields: [crmDealId], references: [id], onDelete: Cascade)

  @@schema("boilerplate")
  @@map("platform_crm_notes")
}

/// Conta comercial da plataforma (lead ou organização) — PRD §17.3
model PlatformAccount {
  id               String   @id @default(uuid())
  name             String
  organizationId   String?  @unique @map("organization_id")
  platformLeadId   String?  @unique @map("platform_lead_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  platformLead   PlatformLead? @relation(fields: [platformLeadId], references: [id], onDelete: Cascade)
  contacts       PlatformContact[]
  crmDeals       CrmDeal[]

  @@schema("boilerplate")
  @@map("platform_accounts")
}

/// Contato (decisor / usuário futuro) — PRD §17.3
model PlatformContact {
  id                String   @id @default(uuid())
  name              String
  email             String?
  phone             String?
  role              String?
  platformAccountId String?  @map("platform_account_id")
  platformLeadId    String?  @map("platform_lead_id")
  createdAt         DateTime @default(now()) @map("created_at")

  platformAccount PlatformAccount? @relation(fields: [platformAccountId], references: [id], onDelete: Cascade)
  platformLead    PlatformLead?    @relation(fields: [platformLeadId], references: [id], onDelete: Cascade)
  consents        PlatformCommsConsent[]

  @@schema("boilerplate")
  @@map("platform_contacts")
}

/// Thread omnichannel (inbox) — PRD §17.4
model PlatformCommsThread {
  id                     String    @id @default(uuid())
  subject                String
  channel                String
  status                 String    @default("open")
  lastMessageAt          DateTime? @map("last_message_at")
  organizationId         String?   @map("organization_id")
  platformLeadId         String?   @map("platform_lead_id")
  assignedPlatformUserId String?   @map("assigned_platform_user_id")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  messages     PlatformCommsMessage[]
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  platformLead PlatformLead? @relation(fields: [platformLeadId], references: [id], onDelete: Cascade)
  activities   PlatformActivity[]

  @@index([organizationId])
  @@index([platformLeadId])
  @@schema("boilerplate")
  @@map("platform_comms_threads")
}

model PlatformCommsMessage {
  id        String   @id @default(uuid())
  threadId  String   @map("thread_id")
  direction String
  body      String
  fromLabel String?  @map("from_label")
  toLabel   String?  @map("to_label")
  createdAt DateTime @default(now()) @map("created_at")

  thread PlatformCommsThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@schema("boilerplate")
  @@map("platform_comms_messages")
}

/// Opt-in LGPD por canal — PRD §17.4
model PlatformCommsConsent {
  id                String    @id @default(uuid())
  channel           String
  organizationId    String?   @map("organization_id")
  platformLeadId    String?   @map("platform_lead_id")
  platformContactId String?   @map("platform_contact_id")
  consentedAt       DateTime  @default(now()) @map("consented_at")
  revokedAt         DateTime? @map("revoked_at")

  organization    Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  platformLead    PlatformLead?   @relation(fields: [platformLeadId], references: [id], onDelete: Cascade)
  platformContact PlatformContact? @relation(fields: [platformContactId], references: [id], onDelete: Cascade)

  @@schema("boilerplate")
  @@map("platform_comms_consents")
}

/// Atividade comercial (nota, ligação, mensagem) — PRD §17.3
model PlatformActivity {
  id               String   @id @default(uuid())
  activityType     String   @map("activity_type")
  body             String
  organizationId   String?  @map("organization_id")
  platformLeadId   String?  @map("platform_lead_id")
  platformUserId   String?  @map("platform_user_id")
  commsThreadId    String?  @map("comms_thread_id")
  createdAt        DateTime @default(now()) @map("created_at")

  organization   Organization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  platformLead   PlatformLead?      @relation(fields: [platformLeadId], references: [id], onDelete: Cascade)
  commsThread    PlatformCommsThread? @relation(fields: [commsThreadId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([platformLeadId])
  @@schema("boilerplate")
  @@map("platform_activities")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  passwordHash String?  @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  memberships Membership[]

  @@schema("boilerplate")
  @@map("users")
}

/// Operadores internos do painel platform-admin (PRD §17.6)
model PlatformUser {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  passwordHash String?  @map("password_hash")
  /// platform_admin | platform_comercial | platform_suporte | platform_produto | platform_engenharia
  role         String   @default("platform_admin")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@schema("boilerplate")
  @@map("platform_users")
}

model Membership {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  organizationId String   @map("organization_id")
  role           String   @default("dono")
  createdAt      DateTime @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([userId, organizationId])
  @@schema("boilerplate")
  @@map("memberships")
}

model Sector {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  name           String
  slug           String @default("geral")

  @@unique([organizationId, slug])
  @@schema("boilerplate")
  @@map("sectors")
}

model ModuloAtivo {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  moduloId       String   @map("modulo_id")
  ativadoEm      DateTime @default(now()) @map("ativado_em")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, moduloId])
  @@schema("boilerplate")
  @@map("modulos_ativos")
}

model ModuloDemanda {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  moduloId       String   @map("modulo_id")
  motivo         String?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@schema("boilerplate")
  @@map("modulo_demanda")
}

/// Preço mensal por módulo (add-on) — PRD §12.2
model ModuloPreco {
  moduleId              String   @id @map("module_id")
  precoMensalCentavos   Int      @map("preco_mensal_centavos")
  faseMinima            Int      @default(1) @map("fase_minima")
  cobrancaAvulsa        Boolean  @default(true) @map("cobranca_avulsa")
  ativo                 Boolean  @default(true)
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@schema("boilerplate")
  @@map("modulo_precos")
}

/// Plano base por faixa de fase — PRD §12.1
model PlanoBase {
  id                  String   @id
  nome                String
  precoMensalCentavos Int      @map("preco_mensal_centavos")
  faseMinima          Int      @map("fase_minima")
  faseMaxima          Int      @map("fase_maxima")
  modulosInclusos     Json     @default("[]") @map("modulos_inclusos")
  ativo               Boolean  @default(true)
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@schema("boilerplate")
  @@map("planos_base")
}

/// Bundle de módulos com preço único — PRD §12.2 / §9.3
model BundlePreco {
  id                  String   @id
  nome                String
  moduleIds           Json     @default("[]") @map("module_ids")
  precoMensalCentavos Int      @map("preco_mensal_centavos")
  ativo               Boolean  @default(true)
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@schema("boilerplate")
  @@map("bundle_precos")
}

/// Rascunho do cadastro conversacional (reutilizado no onboarding sem repetir perguntas)
model SignupDraft {
  email     String   @id
  payload   Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@schema("boilerplate")
  @@map("signup_drafts")
}

/// Código de verificação de e-mail no cadastro (Aprendiz)
model SignupEmailVerification {
  id         String    @id @default(uuid())
  email      String
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  verifiedAt DateTime? @map("verified_at")
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@schema("boilerplate")
  @@map("signup_email_verifications")
}

/// Código para recuperação de senha (login do tenant)
model PasswordResetVerification {
  id         String    @id @default(uuid())
  email      String
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  verifiedAt DateTime? @map("verified_at")
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@schema("boilerplate")
  @@map("password_reset_verifications")
}

/// Auditoria de eventos de domínio (PRD §8.9)
model DomainEvent {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  eventType      String   @map("event_type")
  payload        Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@schema("boilerplate")
  @@map("domain_events")
}
