generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["boilerplate"]
}

model Organization {
  id                String   @id @default(uuid())
  name              String
  slug              String   @unique
  schemaName        String   @unique @map("schema_name")
  phase             Int      @default(1)
  /// lead | trial | active | expansion | churn_risk
  crmStage          String   @default("trial") @map("crm_stage")
  tipoNegocio       String   @map("tipo_negocio")
  segmentoAtuacao   String?  @map("segmento_atuacao")
  hasCnpj           Boolean  @default(false) @map("has_cnpj")
  cnpj              String?
  fiscalReady       Boolean  @default(false) @map("fiscal_ready")
  tipoNegocioInteresse String? @map("tipo_negocio_interesse")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  modulosAtivos  ModuloAtivo[]
  moduloDemanda  ModuloDemanda[]
  memberships    Membership[]
  branches       Branch[]
  sellerInvites  SellerInvite[]
  crmDeals            CrmDeal[]
  crmNotes            PlatformCrmNote[]
  platformAccount     PlatformAccount?
  platformCommsThreads PlatformCommsThread[]
  platformActivities  PlatformActivity[]
  platformCommsConsents PlatformCommsConsent[]

  @@schema("boilerplate")
  @@map("organizations")
}

/// Lead comercial antes de virar tenant (PRD §17.3)
model PlatformLead {
  id              String   @id @default(uuid())
  name            String
  email           String?
  tipoNegocio     String?  @map("tipo_negocio")
  estimatedPhase  Int?     @map("estimated_phase")
  crmStage        String   @default("lead") @map("crm_stage")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  crmDeals              CrmDeal[]
  crmNotes              PlatformCrmNote[]
  platformAccount       PlatformAccount?
  platformCommsThreads  PlatformCommsThread[]
  platformActivities    PlatformActivity[]
  platformCommsConsents PlatformCommsConsent[]
  platformContacts      PlatformContact[]

  @@schema("boilerplate")
  @@map("platform_leads")
}

/// Oportunidade / vínculo pipeline (organização ou lead)
model CrmDeal {
  id                  String   @id @default(uuid())
  organizationId      String?  @map("organization_id")
  platformLeadId      String?  @map("platform_lead_id")
  platformAccountId   String?  @map("platform_account_id")
  phase               Int      @default(1)
  pipelineStage       String   @map("pipeline_stage")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  organization    Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  platformLead    PlatformLead?   @relation(fields: [platformLeadId], references: [id], onDelete: Cascade)
  platformAccount PlatformAccount? @relation(fields: [platformAccountId], references: [id], onDelete: SetNull)
  notes           PlatformCrmNote[]

  @@schema("boilerplate")
  @@map("crm_deals")
}

model PlatformCrmNote {
  id                    String   @id @default(uuid())
  body                  String
  organizationId        String?  @map("organization_id")
  platformLeadId        String?  @map("platform_lead_id")
  crmDealId             String?  @map("crm_deal_id")
  platformUserId        String?  @map("platform_user_id")
  createdAt             DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  platformLead PlatformLead? @relation(fields: [platformLeadId], references: [id], onDelete: Cascade)
  crmDeal      CrmDeal?      @relation(fields: [crmDealId], references: [id], onDelete: Cascade)

  @@schema("boilerplate")
  @@map("platform_crm_notes")
}

/// Conta comercial da plataforma (lead ou organização) — PRD §17.3
model PlatformAccount {
  id               String   @id @default(uuid())
  name             String
  organizationId   String?  @unique @map("organization_id")
  platformLeadId   String?  @unique @map("platform_lead_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  platformLead   PlatformLead? @relation(fields: [platformLeadId], references: [id], onDelete: Cascade)
  contacts       PlatformContact[]
  crmDeals       CrmDeal[]

  @@schema("boilerplate")
  @@map("platform_accounts")
}

/// Contato (decisor / usuário futuro) — PRD §17.3
model PlatformContact {
  id                String   @id @default(uuid())
  name              String
  email             String?
  phone             String?
  role              String?
  platformAccountId String?  @map("platform_account_id")
  platformLeadId    String?  @map("platform_lead_id")
  createdAt         DateTime @default(now()) @map("created_at")

  platformAccount PlatformAccount? @relation(fields: [platformAccountId], references: [id], onDelete: Cascade)
  platformLead    PlatformLead?    @relation(fields: [platformLeadId], references: [id], onDelete: Cascade)
  consents        PlatformCommsConsent[]

  @@schema("boilerplate")
  @@map("platform_contacts")
}

/// Thread omnichannel (inbox) — PRD §17.4
model PlatformCommsThread {
  id                     String    @id @default(uuid())
  subject                String
  channel                String
  status                 String    @default("open")
  lastMessageAt          DateTime? @map("last_message_at")
  organizationId         String?   @map("organization_id")
  platformLeadId         String?   @map("platform_lead_id")
  assignedPlatformUserId String?   @map("assigned_platform_user_id")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  messages     PlatformCommsMessage[]
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  platformLead PlatformLead? @relation(fields: [platformLeadId], references: [id], onDelete: Cascade)
  activities   PlatformActivity[]

  @@index([organizationId])
  @@index([platformLeadId])
  @@schema("boilerplate")
  @@map("platform_comms_threads")
}

model PlatformCommsMessage {
  id        String   @id @default(uuid())
  threadId  String   @map("thread_id")
  direction String
  body      String
  fromLabel String?  @map("from_label")
  toLabel   String?  @map("to_label")
  createdAt DateTime @default(now()) @map("created_at")

  thread PlatformCommsThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@schema("boilerplate")
  @@map("platform_comms_messages")
}

/// Opt-in LGPD por canal — PRD §17.4
model PlatformCommsConsent {
  id                String    @id @default(uuid())
  channel           String
  organizationId    String?   @map("organization_id")
  platformLeadId    String?   @map("platform_lead_id")
  platformContactId String?   @map("platform_contact_id")
  consentedAt       DateTime  @default(now()) @map("consented_at")
  revokedAt         DateTime? @map("revoked_at")

  organization    Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  platformLead    PlatformLead?   @relation(fields: [platformLeadId], references: [id], onDelete: Cascade)
  platformContact PlatformContact? @relation(fields: [platformContactId], references: [id], onDelete: Cascade)

  @@schema("boilerplate")
  @@map("platform_comms_consents")
}

/// Atividade comercial (nota, ligação, mensagem) — PRD §17.3
model PlatformActivity {
  id               String   @id @default(uuid())
  activityType     String   @map("activity_type")
  body             String
  organizationId   String?  @map("organization_id")
  platformLeadId   String?  @map("platform_lead_id")
  platformUserId   String?  @map("platform_user_id")
  commsThreadId    String?  @map("comms_thread_id")
  createdAt        DateTime @default(now()) @map("created_at")

  organization   Organization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  platformLead   PlatformLead?      @relation(fields: [platformLeadId], references: [id], onDelete: Cascade)
  commsThread    PlatformCommsThread? @relation(fields: [commsThreadId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([platformLeadId])
  @@schema("boilerplate")
  @@map("platform_activities")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  passwordHash String?  @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  memberships Membership[]

  @@schema("boilerplate")
  @@map("users")
}

/// Operadores internos do painel platform-admin (PRD §17.6)
model PlatformUser {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  passwordHash String?  @map("password_hash")
  /// platform_admin | platform_comercial | platform_suporte | platform_produto | platform_engenharia
  role         String   @default("platform_admin")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@schema("boilerplate")
  @@map("platform_users")
}

model Membership {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  organizationId  String   @map("organization_id")
  role            String   @default("dono")
  active          Boolean  @default(true)
  defaultBranchId String?  @map("default_branch_id")
  createdAt       DateTime @default(now()) @map("created_at")

  user              User               @relation(fields: [userId], references: [id])
  organization      Organization       @relation(fields: [organizationId], references: [id])
  defaultBranch     Branch?            @relation(fields: [defaultBranchId], references: [id], onDelete: SetNull)
  membershipSectors       MembershipSector[]
  membershipSectorModules MembershipSectorModule[]

  @@unique([userId, organizationId])
  @@schema("boilerplate")
  @@map("memberships")
}

model Branch {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  slug           String
  active         Boolean  @default(true)
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  Membership[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@schema("boilerplate")
  @@map("branches")
}

model Sector {
  id              String  @id @default(uuid())
  organizationId  String  @map("organization_id")
  name            String
  slug            String  @default("geral")
  coreSectorSlug  String? @map("core_sector_slug")
  /// IDs dos cards do painel inicial por setor (ex.: cash_flow, clients, stock_alerts)
  dashboardCards  Json    @default("[\"cash_flow\",\"clients\",\"stock_alerts\"]") @map("dashboard_cards")

  sectorModules           SectorModule[]
  membershipSectors       MembershipSector[]
  membershipSectorModules MembershipSectorModule[]

  @@unique([organizationId, slug])
  @@schema("boilerplate")
  @@map("sectors")
}

model SectorModule {
  id       String @id @default(uuid())
  sectorId String @map("sector_id")
  moduleId String @map("module_id")

  sector Sector @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@unique([sectorId, moduleId])
  @@index([sectorId])
  @@schema("boilerplate")
  @@map("sector_modules")
}

model MembershipSector {
  membershipId String @map("membership_id")
  sectorId     String @map("sector_id")

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  sector     Sector     @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@id([membershipId, sectorId])
  @@schema("boilerplate")
  @@map("membership_sectors")
}

/// Módulos e permissões explícitas do membro em um setor (vazio = herda setor + papel).
model MembershipSectorModule {
  membershipId String @map("membership_id")
  sectorId     String @map("sector_id")
  moduleId     String @map("module_id")
  permissions  Json?  @map("permissions")

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  sector     Sector     @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@id([membershipId, sectorId, moduleId])
  @@index([membershipId, sectorId])
  @@schema("boilerplate")
  @@map("membership_sector_modules")
}

model SellerInvite {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  tenantSellerId String    @map("tenant_seller_id")
  email          String
  token          String    @unique
  expiresAt      DateTime  @map("expires_at")
  acceptedAt     DateTime? @map("accepted_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([token])
  @@schema("boilerplate")
  @@map("seller_invites")
}

/// Setores universais do produto — PRD §5.0 / §8.12
model CoreSector {
  slug     String @id
  name     String
  camada   String
  presenca String
  ordem    Int    @default(0)

  modules CoreModuleCatalog[]

  @@schema("boilerplate")
  @@map("core_sectors")
}

/// Catálogo global de módulos de produto — PRD §8.12
model CoreModuleCatalog {
  id                   String  @id
  name                 String
  sectorSlug           String  @map("sector_slug")
  faseMinima           Int     @default(1) @map("fase_minima")
  implementationStatus String  @default("scaffold") @map("implementation_status")
  depthCurrent         Int     @default(0) @map("depth_current")
  depthTarget          Int     @default(3) @map("depth_target")
  depthTargetMarco     String? @map("depth_target_marco")
  deliveryMarco        String? @map("delivery_marco")
  registrySync         Boolean @default(true) @map("registry_sync")
  depthRubric          Json?   @map("depth_rubric")
  depthNotes           String? @map("depth_notes")
  updatedAt            DateTime @updatedAt @map("updated_at")

  sector    CoreSector             @relation(fields: [sectorSlug], references: [slug])
  changelog ModuleDepthChangelog[]

  @@index([sectorSlug])
  @@schema("boilerplate")
  @@map("core_modules_catalog")
}

/// Segmentos de mercado (estudo) — PRD §5.0.2
model MarketSegment {
  slug  String @id
  name  String
  ordem Int    @default(0)

  sectorModules SegmentSectorModule[]
  vitalModules  SegmentVitalModule[]

  @@schema("boilerplate")
  @@map("market_segments")
}

model SegmentSectorModule {
  id                String @id @default(uuid())
  segmentSlug       String @map("segment_slug")
  sectorSlug        String @map("sector_slug")
  marketModuleLabel String @map("market_module_label")

  segment MarketSegment @relation(fields: [segmentSlug], references: [slug], onDelete: Cascade)

  @@unique([segmentSlug, sectorSlug, marketModuleLabel])
  @@schema("boilerplate")
  @@map("segment_sector_modules")
}

model SegmentVitalModule {
  id              String @id @default(uuid())
  segmentSlug     String @map("segment_slug")
  vitalModuleLabel String @map("vital_module_label")

  segment MarketSegment @relation(fields: [segmentSlug], references: [slug], onDelete: Cascade)

  @@unique([segmentSlug, vitalModuleLabel])
  @@schema("boilerplate")
  @@map("segment_vital_modules")
}

/// Histórico de evolução de profundidade D — PRD §5.0.1
model ModuleDepthChangelog {
  id            String   @id @default(uuid())
  moduleId      String   @map("module_id")
  title         String
  publicSummary String   @map("public_summary")
  depthFrom     Int      @map("depth_from")
  depthTo       Int      @map("depth_to")
  deliveryMarco String?  @map("delivery_marco")
  showToTenants Boolean  @default(true) @map("show_to_tenants")
  releasedAt    DateTime @default(now()) @map("released_at")

  module CoreModuleCatalog @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId, releasedAt])
  @@schema("boilerplate")
  @@map("module_depth_changelog")
}

model ModuloAtivo {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  moduloId       String   @map("modulo_id")
  ativadoEm      DateTime @default(now()) @map("ativado_em")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, moduloId])
  @@schema("boilerplate")
  @@map("modulos_ativos")
}

model ModuloDemanda {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  moduloId       String   @map("modulo_id")
  motivo         String?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@schema("boilerplate")
  @@map("modulo_demanda")
}

/// Preço mensal por módulo (add-on) — PRD §12.2
model ModuloPreco {
  moduleId              String   @id @map("module_id")
  precoMensalCentavos   Int      @map("preco_mensal_centavos")
  faseMinima            Int      @default(1) @map("fase_minima")
  cobrancaAvulsa        Boolean  @default(true) @map("cobranca_avulsa")
  ativo                 Boolean  @default(true)
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@schema("boilerplate")
  @@map("modulo_precos")
}

/// Plano base por faixa de fase — PRD §12.1
model PlanoBase {
  id                  String   @id
  nome                String
  precoMensalCentavos Int      @map("preco_mensal_centavos")
  faseMinima          Int      @map("fase_minima")
  faseMaxima          Int      @map("fase_maxima")
  modulosInclusos     Json     @default("[]") @map("modulos_inclusos")
  ativo               Boolean  @default(true)
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@schema("boilerplate")
  @@map("planos_base")
}

/// Bundle de módulos com preço único — PRD §12.2 / §9.3
model BundlePreco {
  id                  String   @id
  nome                String
  moduleIds           Json     @default("[]") @map("module_ids")
  precoMensalCentavos Int      @map("preco_mensal_centavos")
  ativo               Boolean  @default(true)
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@schema("boilerplate")
  @@map("bundle_precos")
}

/// Rascunho do cadastro conversacional (reutilizado no onboarding sem repetir perguntas)
model SignupDraft {
  email     String   @id
  payload   Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@schema("boilerplate")
  @@map("signup_drafts")
}

/// Código de verificação de e-mail no cadastro (Aprendiz)
model SignupEmailVerification {
  id         String    @id @default(uuid())
  email      String
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  verifiedAt DateTime? @map("verified_at")
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@schema("boilerplate")
  @@map("signup_email_verifications")
}

/// Código para recuperação de senha (login do tenant)
model PasswordResetVerification {
  id         String    @id @default(uuid())
  email      String
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  verifiedAt DateTime? @map("verified_at")
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@schema("boilerplate")
  @@map("password_reset_verifications")
}

/// Auditoria de eventos de domínio (PRD §8.9)
model DomainEvent {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  eventType      String   @map("event_type")
  payload        Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@schema("boilerplate")
  @@map("domain_events")
}
