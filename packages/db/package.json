{
  "name": "@boilerplate/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./organization": "./src/organization.ts",
    "./platform-user": "./src/platform-user.ts",
    "./platform-comms-labels": "./src/platform-comms-labels.ts",
    "./ecosystem-labels": "./src/ecosystem-labels.ts",
    "./platform-crm-ext-labels": "./src/platform-crm-ext-labels.ts",
    "./platform-integrators.types": "./src/platform-integrators.types.ts",
    "./self-hosted": "./src/self-hosted/index.ts"
  },
  "scripts": {
    "build": "bun scripts/generate-client.ts",
    "lint": "tsc --noEmit -p tsconfig.json",
    "db:validate": "bun scripts/prisma-env.ts validate",
    "db:generate": "bun scripts/generate-client.ts",
    "db:push": "bun scripts/prisma-env.ts db push",
    "db:migrate-tenants": "bun --env-file=../../.env --env-file=../../.env.development ./scripts/migrate-tenants.ts",
    "db:seed-platform-admin": "bun ./scripts/seed-platform-admin.ts",
    "db:seed-roadmap": "bun ./scripts/seed-product-roadmap.ts",
    "db:seed-integrator-credentials": "bun ./scripts/seed-integrator-credentials.ts",
    "db:seed-self-hosted": "bun ./scripts/seed-self-hosted.ts",
    "db:schema-sync": "bun ./scripts/vercel-schema-sync.ts",
    "db:setup-remote": "bun ./scripts/setup-remote.ts",
    "db:rotate-kek": "bun ./scripts/rotate-kek.ts",
    "test": "bun test src",
    "db:restart": "bun ./scripts/db-restart.ts"
  },
  "dependencies": {
    "@boilerplate/crm": "workspace:*",
    "@boilerplate/crm-helpdesk": "workspace:*",
    "@boilerplate/billing": "workspace:*",
    "@boilerplate/integrators": "workspace:*",
    "@boilerplate/module-registry": "workspace:*",
    "@boilerplate/shared": "workspace:*",
    "@boilerplate/sdk-core": "workspace:*",
    "@boilerplate/platform-api": "workspace:*",
    "@prisma/client": "^6.9.0",
    "bcryptjs": "^3.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.29",
    "prisma": "^6.9.0",
    "typescript": "^5.8.3"
  }
}
