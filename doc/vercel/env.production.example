# =============================================================================
# Vercel — variáveis para deploy rápido (Preview + Production)
# =============================================================================
#
# 1. Copie para a raiz do monorepo:
#      copy doc\vercel\env.production.example .env.vercel.production
#
# 2. Preencha os valores (gerar secrets: openssl rand -base64 32)
#
# 3. Suba para os dois projetos Vercel:
#      bun run vercel:env-sync
#
# 4. Deploy (admin primeiro — roda bootstrap do banco):
#      cd apps/platform-admin && bunx vercel deploy
#      cd apps/web && bunx vercel deploy
#
# Referência completa: doc/vercel/environment-variables.md
# Nunca commite .env.vercel.production (gitignored).

# --- Metadados do deploy (não vão para a Vercel) ---
# Branch Git usada nos deploys Preview (ajuste se necessário)
VERCEL_PREVIEW_BRANCH=feature/open-enterprise-boilerplate

# URLs públicas dos projetos Vercel (Settings → Domains ou vercel project ls)
VERCEL_WEB_URL=https://boilerplate-web-seu-team.vercel.app
VERCEL_ADMIN_URL=https://boilerplate-platform-admin-seu-team.vercel.app

# =============================================================================
# COMPARTILHADAS — mesmo valor em web e platform-admin
# =============================================================================

# Neon / Vercel Storage — connection string PostgreSQL
DATABASE_URL=

# KEK AES-256 para credenciais de integradores (32 bytes base64)
# openssl rand -base64 32
INTEGRATOR_ENCRYPTION_KEY=

# URLs expostas ao browser (links, redirects, CORS)
# Se omitir, usa VERCEL_WEB_URL / VERCEL_ADMIN_URL
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_PLATFORM_ADMIN_URL=

# =============================================================================
# WEB (apps/web) — secrets distintos do admin
# =============================================================================

# openssl rand -base64 32 — valor DIFERENTE do AUTH_SECRET_PLATFORM_ADMIN
AUTH_SECRET_WEB=

# Fallback legado (opcional se AUTH_SECRET_WEB estiver definido)
# AUTH_SECRET=

# Auth.js — URL pública do app tenant (default: VERCEL_WEB_URL)
AUTH_URL_WEB=

# =============================================================================
# PLATFORM-ADMIN (apps/platform-admin)
# =============================================================================

# openssl rand -base64 32 — valor DIFERENTE do AUTH_SECRET_WEB
AUTH_SECRET_PLATFORM_ADMIN=

# Auth.js — URL pública do admin (default: VERCEL_ADMIN_URL)
AUTH_URL_ADMIN=

# Bootstrap idempotente no build (recomendado: true só no admin)
RUN_VERCEL_DB_BOOTSTRAP=true
ALLOW_PLATFORM_ADMIN_SEED=true
ALLOW_INTEGRATOR_CREDENTIALS_SEED=true

PLATFORM_ADMIN_SEED_EMAIL=
PLATFORM_ADMIN_SEED_PASSWORD=
PLATFORM_ADMIN_SEED_NAME=Super Admin

# =============================================================================
# OPCIONAIS — recomendado em Preview/Production
# =============================================================================

# Upstash Redis (rate limiting distribuído)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# E-mail (fallback se integrador Resend não configurado no admin)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Boilerplate <noreply@seudominio.com>

# Webhooks de pagamento (obrigatório antes de expor /api/webhooks/payment/*)
# PAYMENT_WEBHOOK_SECRET=
