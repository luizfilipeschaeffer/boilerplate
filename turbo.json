{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["DATABASE_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "src/generated/**"],
      "env": [
        "DATABASE_URL",
        "AUTH_SECRET",
        "AUTH_SECRET_WEB",
        "AUTH_SECRET_PLATFORM_ADMIN",
        "AUTH_URL",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_PLATFORM_ADMIN_URL",
        "INTEGRATOR_ENCRYPTION_KEY",
        "RESEND_FROM_EMAIL",
        "ASAAS_API_KEY",
        "ASAAS_API_URL",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "PAYMENT_WEBHOOK_SECRET",
        "RUN_VERCEL_DB_BOOTSTRAP",
        "ALLOW_PLATFORM_ADMIN_SEED",
        "ALLOW_INTEGRATOR_CREDENTIALS_SEED",
        "PLATFORM_ADMIN_SEED_EMAIL",
        "PLATFORM_ADMIN_SEED_PASSWORD",
        "PLATFORM_ADMIN_SEED_NAME",
        "VERCEL_ENV"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^test"]
    }
  }
}
